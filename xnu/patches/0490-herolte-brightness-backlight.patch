--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -214,6 +214,97 @@
 
 OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
 
+/*
+ * Backlight (from upstream Note FE 0419/0420): an AppleARMBacklight child of the display with IODisplayParameters
+ * (brightness 0-65536) so CoreBrightness finds a backlight. The level reaches the panel through the GPU copy's blend
+ * (herolte_gpu.c); boot-arg herobl=0 publishes none.
+ */
+extern "C" void notefe_brightness_set(uint32_t level, const char *why);
+
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+public:
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+static OSDictionary *
+notefe_range(uint32_t value)
+{
+	OSDictionary *d = OSDictionary::withCapacity(3);
+	if (d) {
+		OSNumber *n;
+		n = OSNumber::withNumber(0ULL, 32); d->setObject("min", n); n->release();
+		n = OSNumber::withNumber(65536ULL, 32); d->setObject("max", n); n->release();
+		n = OSNumber::withNumber((unsigned long long)value, 32); d->setObject("value", n); n->release();
+	}
+	return d;
+}
+
+static void
+notefe_backlight_publish(IOService *display)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("herobl", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	AppleARMBacklight *bl = OSTypeAlloc(AppleARMBacklight);
+	if (bl == NULL || !bl->init()) {
+		IOLog("HEROLTE BRIGHT: backlight service not made\n");
+		return;
+	}
+	OSDictionary *params = OSDictionary::withCapacity(3);
+	OSDictionary *b = notefe_range(65536), *lb = notefe_range(65536), *commit = OSDictionary::withCapacity(1);
+	OSNumber *zero = OSNumber::withNumber(0ULL, 32);
+	commit->setObject("reg", zero);
+	params->setObject("brightness", b);
+	params->setObject("linear-brightness", lb);
+	params->setObject("commit", commit);
+	bl->setProperty("IODisplayParameters", params);
+	bl->setProperty("backlight-control", true);
+	bl->setName("backlight");
+	b->release(); lb->release(); commit->release(); zero->release(); params->release();
+	if (!bl->attach(display)) {
+		IOLog("HEROLTE BRIGHT: backlight service not attached\n");
+		bl->release();
+		return;
+	}
+	bl->registerService();
+	IOLog("HEROLTE BRIGHT: AppleARMBacklight published under the display\n");
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	OSDictionary *bright = dict ? OSDynamicCast(OSDictionary, dict->getObject("brightness")) : NULL;
+	OSNumber *v = bright ? OSDynamicCast(OSNumber, bright->getObject("value")) : NULL;
+	if (v == NULL && dict) {
+		v = OSDynamicCast(OSNumber, dict->getObject("brightness"));
+	}
+	if (v) {
+		/* CoreBrightness sends linear light (65536 = full); pixels scaled by k give about k^2.2 light on this
+		 * AMOLED, so the pixel factor is about the square root of the level (0420). */
+		uint64_t x = v->unsigned64BitValue();
+		if (x > 65536) {
+			x = 65536;
+		}
+		uint64_t n = x * 65536, lo = 0, hi = 65536;
+		while (lo < hi) {
+			uint64_t mid = (lo + hi + 1) / 2;
+			if (mid * mid <= n) {
+				lo = mid;
+			} else {
+				hi = mid - 1;
+			}
+		}
+		notefe_brightness_set((uint32_t)(lo >= 65536 ? 255 : lo * 255 / 65536), "backlight");
+	}
+	return kIOReturnSuccess;
+}
