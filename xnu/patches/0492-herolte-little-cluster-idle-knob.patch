+/*
+ * 0492 (D-0128): kern.hero_little_idle=1 lets the power thread lower the little cluster while the screen has been off
+ * for 10 s, and brings it back as soon as the screen is on again or the sysctl is 0. 533 MHz is the boot PLL setting
+ * with its post divider at 2 (M 123, P 3, S 1: the VCO does not move) with the dividers of the ECT's 546 MHz row; the
+ * voltage is 0.675 V (0x3c), 25 mV above what Linux held this phone's cluster at for 546 MHz (E-0314). Off by default.
+ * kern.hero_little_state: 0 as booted, 1 lowered, -1 given up (nothing more is written).
+ */
+static int ap_idle_want;
+static int ap_idle_state;
+SYSCTL_INT(_kern, OID_AUTO, hero_little_idle, CTLFLAG_RW | CTLFLAG_LOCKED, &ap_idle_want, 0,
+    "HEROLTE: lower the little cluster while the screen is off");
+SYSCTL_INT(_kern, OID_AUTO, hero_little_state, CTLFLAG_RD | CTLFLAG_LOCKED, &ap_idle_state, 0,
+    "HEROLTE: the little cluster: 0 as booted, 1 lowered, -1 given up");
+
+static void
+ap_idle_follow(bool screen_off_long, unsigned boot_arg_mhz)
+{
+	bool want = ap_idle_want != 0 && screen_off_long && !boot_arg_mhz;
+	if (want == (ap_idle_state == 1) || ap_idle_state < 0 || ap.broken) {
+		if (ap.broken && ap_idle_want) {
+			ap_idle_state = -1;
+		}
+		return;
+	}
+	if (!ap.done) {
+		if (!hc.top || !hc.saved) {
+			return;
+		}
+		ap.cmu = ml_io_map(AP_CMU_PA, 0x1000);
+		if (!ap.cmu || !ap_check_boot_state()) {
+			printf("HEROLTE LITTLE: idle: the cluster is not in the 1066 MHz state of the table: nothing is written\n");
+			ap.broken = true;
+			ap_idle_state = -1;
+			return;
+		}
+		ap.done = true;
+	}
+	static unsigned changes;
+	bool say = ++changes <= 40 || changes % 100 == 0;
+	if (want) {
+		/* down: the clock first (still at 0.819 V), the voltage after */
+		ap_to_switch();
+		if (!ap_relock_s(123, 1)) {
+			printf("HEROLTE LITTLE: idle: APOLLO_PLL did not lock (%#x): stays on the switch\n", hg_rd(ap.cmu, 0x100));
+			ap.broken = true;
+			ap_idle_state = -1;
+			return;
+		}
+		ap_set_divs(AP_IDLE_ROW);
+		ap_from_switch();
+		ap_idle_state = 1;
+		bool ok = ap_volt(0x3c);
+		if (!ok) {
+			ap_volt(0x53);          /* the voltage did not take: keep the booted one with the low clock */
+		}
+		if (say || !ok) {
+			printf("HEROLTE LITTLE: idle: 533 MHz (con0 %#x), vdd_apollo 0x3c %s (change %u)\n", hg_rd(ap.cmu, 0x100),
+			    ok ? "set" : "FAILED", changes);
+		}
+	} else {
+		/* up: the voltage first; without it the clock is not raised (tried again at the next pass) */
+		if (!ap_volt(0x53)) {
+			printf("HEROLTE LITTLE: idle: vdd_apollo 0x53 FAILED: the cluster stays at 533 MHz\n");
+			return;
+		}
+		ap_set_divs(1066);
+		ap_to_switch();
+		if (!ap_relock(123)) {
+			printf("HEROLTE LITTLE: idle: APOLLO_PLL did not lock at 1066 (%#x)\n", hg_rd(ap.cmu, 0x100));
+			ap.broken = true;
+			ap_idle_state = -1;
+			return;
+		}
+		ap_from_switch();
+		ap_idle_state = 0;
+		if (say) {
+			printf("HEROLTE LITTLE: idle: back to 1066 MHz (con0 %#x), vdd_apollo 0x53 (change %u)\n", hg_rd(ap.cmu, 0x100), changes);
+		}
+	}
+}
