diag(min6): keep the early alias until arm_vm_init switches TTBR0, and draw progress blocks inside arm_vm_init and between 6a and 7

0339 left the early console off from the stage-7 mark on (a5_active=0), so the existing marks inside arm_vm_init (0327) and block 9 never drew. Now the alias stays active until sweet_early_disable() right before set_mmu_ttb(invalid_ttep). New blocks in the x=1300 column: slots 10-12 in arm_init (after the maxmem chain, after nanoseconds/hygiene section marks, after immediate_NMI), 13-19 in arm_vm_init (start, physmap tables, prot_init, before/after arm_vm_physmap_init, after set_mmu_ttb_alternate, just before TTBR0 off). Drawing only; no logic change.

--- a/osfmk/arm/arm_init.c	2026-11-14 14:36:03.126761024 +0100
+++ b/osfmk/arm/arm_init.c	2026-11-14 14:36:03.152296431 +0100
@@ -513,6 +513,7 @@
 	} else {
 		xmaxmem = 0;
 	}
+	sweet_early_block(10, 0xffff69b4);
 
 #if SCHED_HYGIENE_DEBUG
 	{
@@ -539,6 +540,7 @@
 #endif /* SCHED_HYGIENE_DEBUG */
 
 	sweet_early_mark(6, "6b maxmem and hygiene done");
+	sweet_early_block(11, 0xff40e0d0);
 	sweet_early_block(7, 0xff80ff00);
 	nanoseconds_to_absolutetime(XCALL_ACK_TIMEOUT_NS, &xcall_ack_timeout_abstime);
 
@@ -548,6 +550,7 @@
 #endif
 
 	PE_parse_boot_argn("immediate_NMI", &force_immediate_debug_halt, sizeof(force_immediate_debug_halt));
+	sweet_early_block(12, 0xffa0522d);
 
 #if __ARM_PAN_AVAILABLE__
 	__builtin_arm_wsr("pan", 1);
--- a/osfmk/arm64/sweet_early.c	2026-11-14 14:36:03.129118786 +0100
+++ b/osfmk/arm64/sweet_early.c	2026-11-14 14:36:03.151996676 +0100
@@ -87,10 +87,8 @@
 	a5_string(label);
 	sweet_early_putc('\n');
 	__asm__ volatile("dsb sy" ::: "memory");
-	/* arm_vm_init replaces TTBR0; low physical aliases then cease to exist. */
-	if (stage == 7) {
-		a5_active = 0;
-	}
+	/* min6: the low physical alias lives until arm_vm_init switches TTBR0; arm_vm_init calls
+	 * sweet_early_disable() right before that, so marks inside arm_vm_init can still draw. */
 }
 
 void
--- a/osfmk/arm64/arm_vm_init.c	2026-11-14 14:36:03.129180954 +0100
+++ b/osfmk/arm64/arm_vm_init.c	2026-11-14 14:36:03.152959375 +0100
@@ -2012,6 +2012,7 @@
 	 * to trampoline to KVA. this requires only 3 pages to stay resident.
 	 */
 	avail_start = args->topOfKernelData;
+	sweet_early_block(13, 0xffff69b4);
 
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
 	sweet_early_mark(7, "rb: identity map");
@@ -2054,6 +2055,7 @@
 	 *   the rest of the kernel virtual address space
 	 */
 	sweet_early_mark(7, "rb: physmap tables");
+	sweet_early_block(14, 0xff40e0d0);
 	init_ptpages(cpu_tte, physmap_base, ROUND_L1(physmap_end), TRUE, ARM_DYNAMIC_TABLE_XN | ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA));
 #endif
 
@@ -2171,6 +2173,7 @@
 	vm_prelink_edata = segPRELINKDATAB + segSizePRELINKDATA;
 
 	sweet_early_mark(7, "rb: prot_init");
+	sweet_early_block(15, 0xffa0522d);
 	arm_vm_prot_init(args);
 
 	/*
@@ -2222,8 +2225,11 @@
 	sweet_early_map_final();
 #endif
 	sweet_early_mark(7, "rb: physmap_init");
+	sweet_early_block(16, 0xffff1493);
 	arm_vm_physmap_init(args);
+	sweet_early_block(17, 0xff00ced1);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
+	sweet_early_block(18, 0xffd2691e);
 
 	ml_enable_monitor();
 
@@ -2231,6 +2237,10 @@
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
 	sweet_early_relocate(SWEET_EARLY_FB_VA);
 #endif
+#if defined(A5XELTE)
+	sweet_early_block(19, 0xffffffff);
