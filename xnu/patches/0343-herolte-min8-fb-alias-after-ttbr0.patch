+#if defined(A5XELTE)
+/*
+ * min8: keep the early framebuffer console alive past the TTBR0 switch. Map the 32 MiB block that contains the DECON scanout
+ * buffer (Normal-NC) in the final table at the otherwise empty VA above the low globals, as the donor's
+ * sweet_early_map_final() does, and let sweet_early_relocate() point the early drawing there.
+ */
+#define A5_EARLY_FB_BLOCK_PA (A5XELTE_FB_PA & ~(uint64_t)(ARM_TT_L2_SIZE - 1))
+#define A5_EARLY_FB_VA       (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#define A5_EARLY_FB_OFF      (A5XELTE_FB_PA - A5_EARLY_FB_BLOCK_PA)
+
+static void
+a5_early_map_final(void)
+{
+	const vm_map_address_t va = A5_EARLY_FB_VA;
+	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+	assert(*slot == ARM_TTE_EMPTY);
+	*slot = (uint64_t)A5_EARLY_FB_BLOCK_PA | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	__asm__ volatile ("dsb ishst" ::: "memory");
+}
+#endif
