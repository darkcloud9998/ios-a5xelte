--- a/osfmk/arm64/sweet_early.c	2026-11-14 13:40:30.098749720 +0100
+++ b/osfmk/arm64/sweet_early.c	2026-11-14 13:40:44.357753149 +0100
@@ -109,6 +109,26 @@
