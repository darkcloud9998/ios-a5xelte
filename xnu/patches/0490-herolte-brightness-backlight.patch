herolte: panel brightness through a backlight service and the GPU copy blend (0490)

From upstream Note FE 0419/0420/0343 (the parts for brightness only; the rest of 0342 stays held back). An AppleARMBacklight child of the display with IODisplayParameters (brightness 0-65536; boot-arg herobl=0 publishes none) receives what CoreBrightness sets; notefe_brightness_set() maps it (square root, light is about level^2.2 on this AMOLED), with a floor of 64 of 255 (herobrightmin=N, 12-255) because without a light sensor auto-brightness asks for 1 and the screen turns black. The GPU copy to the panel multiplies every pixel by level/255 through the blend constant (255: exactly the copy as before). Cost: the screen never goes below 25 percent.

--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -2021,6 +2021,33 @@
  * the rect to the point of coherency. False if the GPU failed (the caller
  * falls back to the CPU copy).
  */
+/* The panel's brightness, 255 = as drawn. Set by the backlight service (SweetFramebuffer.cpp). */
+static volatile uint32_t notefe_bright_level = 255;
+
+void notefe_brightness_set(uint32_t level, const char *why);
+void
+notefe_brightness_set(uint32_t level, const char *why)
+{
+	static uint32_t logged, floor_level;
+	if (level > 255) {
+		level = 255;
+	}
+	/* A floor that stays readable (0343): with no light sensor auto-brightness asks for 1 and the screen is black.
+	 * Boot-arg herobrightmin=N (12-255, default 64). */
+	if (floor_level == 0) {
+		uint32_t m = 64;
+		PE_parse_boot_argn("herobrightmin", &m, sizeof(m));
+		floor_level = m < 12 ? 12 : m > 255 ? 255 : m;
+	}
+	if (level < floor_level) {
+		level = floor_level;
+	}
+	if (level != notefe_bright_level && (++logged <= 60 || logged % 50 == 0)) {
+		printf("HEROLTE BRIGHT: %u -> %u (%s)\n", notefe_bright_level, level, why);
+	}
+	notefe_bright_level = level;
+}
