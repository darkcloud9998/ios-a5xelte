 }
 
+/*
+ * Persistent progress block (min5): 36x21 pixels in a column at x=1300, y=88+32*slot, far right of the widest
+ * stage-text line (about 1060 px at scale 3) so the text can never overwrite it. Same physical alias as the text
+ * (valid until arm_vm_init replaces TTBR0), so it follows a5_active.
+ */
+void
+sweet_early_block(unsigned int slot, uint32_t argb)
+{
+	if (!a5_active || slot > 60) {
+		return;
+	}
+	for (unsigned int y = 0; y < 21; y++) {
+		volatile uint32_t *line = A5_FB + (88u + 32u * slot + y) * A5_STRIDE + 1300u;
+		for (unsigned int x = 0; x < 36; x++) {
+			line[x] = argb;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
 void sweet_early_relocate(uint64_t base) { (void)base; }
 void sweet_early_disable(void) { a5_active = 0; }
 #elif defined(SWEET)
@@ -244,4 +264,6 @@
 	early_disabled = 1;
